{
  "version": 1,
  "brightness": 0.8,
  "haptics": true,
  "swipePages": true,
  "autoSwitch": true,
  "startPage": "home",
  "theme": {
    "background": "#000000",
    "key": "#1f2937",
    "text": "#f8fafc",
    "accent": "#38bdf8",
    "active": "#dc2626"
  },
  "appRules": [
    {
      "title": "Onshape",
      "page": "onshape"
    },
    {
      "exe": "figma.exe",
      "page": "figma"
    },
    {
      "title": "[–-] Figma( - |$)",
      "page": "figma"
    },
    {
      "exe": "windowsterminal.exe",
      "page": "terminal"
    }
  ],
  "global": {
    "knobs": {
      "knobTL": {
        "label": "Volume",
        "icon": "🔊",
        "widget": {
          "type": "volume",
          "target": "speakers"
        },
        "rotate": {
          "type": "volume",
          "target": "speakers",
          "step": 0.02
        },
        "press": {
          "type": "mute",
          "target": "speakers"
        }
      },
      "knobCL": {
        "label": "Mic",
        "icon": "🎤",
        "widget": {
          "type": "volume",
          "target": "mic"
        },
        "rotate": {
          "type": "volume",
          "target": "mic",
          "step": 0.02
        },
        "press": {
          "type": "mute",
          "target": "mic"
        }
      },
      "knobBL": {
        "label": "Scroll",
        "icon": "↕",
        "rotate": {
          "type": "scroll",
          "amount": -1
        }
      },
      "knobTR": {
        "label": "Tracks",
        "icon": "🎵",
        "left": {
          "type": "media",
          "key": "prev"
        },
        "right": {
          "type": "media",
          "key": "next"
        },
        "press": {
          "type": "media",
          "key": "playpause"
        }
      },
      "knobCR": {
        "label": "H-Scroll",
        "icon": "↔",
        "rotate": {
          "type": "scroll",
          "amount": 1,
          "horizontal": true
        }
      },
      "knobBR": {
        "label": "Light",
        "icon": "💡",
        "widget": {
          "type": "light"
        },
        "rotate": {
          "type": "light",
          "op": "brightness",
          "step": 0.05
        },
        "press": {
          "type": "light",
          "op": "toggle"
        },
        "activeColor": "#f59e0b"
      }
    },
    "wheel": {
      "label": "Scroll",
      "rotate": {
        "type": "scroll",
        "amount": -1
      },
      "sensitivity": 1,
      "press": {
        "type": "page",
        "page": "next"
      }
    },
    "buttons": {
      "0": {
        "label": "Home",
        "action": {
          "type": "page",
          "page": "home"
        }
      },
      "1": {
        "label": "Media",
        "action": {
          "type": "page",
          "page": "media"
        }
      },
      "2": {
        "label": "Edit",
        "action": {
          "type": "page",
          "page": "edit"
        }
      },
      "3": {
        "label": "Windows",
        "action": {
          "type": "page",
          "page": "windows"
        }
      },
      "6": {
        "label": "Light",
        "color": "#000000",
        "activeColor": "#f59e0b",
        "widget": {
          "type": "light"
        },
        "action": {
          "type": "light",
          "op": "toggle"
        }
      },
      "7": {
        "label": "Mic mute",
        "color": "#16a34a",
        "activeColor": "#dc2626",
        "widget": {
          "type": "mute",
          "target": "mic"
        },
        "action": {
          "type": "mute",
          "target": "mic"
        }
      },
      "home": {
        "label": "Home page",
        "action": {
          "type": "page",
          "page": "home"
        }
      },
      "undo": {
        "label": "Undo",
        "action": {
          "type": "hotkey",
          "keys": "ctrl+z"
        },
        "longPress": {
          "type": "hotkey",
          "keys": "ctrl+y"
        }
      },
      "save": {
        "label": "Save",
        "action": {
          "type": "hotkey",
          "keys": "ctrl+s"
        }
      },
      "enter": {
        "label": "Enter",
        "action": {
          "type": "hotkey",
          "keys": "enter"
        }
      },
      "keyboard": {
        "label": "Emoji panel",
        "action": {
          "type": "hotkey",
          "keys": "win+."
        }
      }
    }
  },
